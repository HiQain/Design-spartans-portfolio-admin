modules = ["nodejs-24"]

[[artifacts]]
id = "artifacts/api-server"

[[artifacts]]
id = "artifacts/mockup-sandbox"

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

[userenv]

# Firebase is no longer used (replaced by the custom MySQL/Express backend in
# artifacts/api-server). Real deployment secrets now needed here instead:
# DATABASE_URL, JWT_SECRET, API_PUBLIC_BASE_URL, CORS_ORIGIN, VITE_API_BASE_URL.
[userenv.shared]
