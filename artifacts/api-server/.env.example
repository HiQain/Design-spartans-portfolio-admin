PORT=4000

# MySQL connection string, e.g. mysql://user:password@host:3306/database_name
DATABASE_URL=

# Long random string used to sign auth JWTs (e.g. `openssl rand -hex 32`)
JWT_SECRET=

# Absolute path where uploaded images are stored on disk. Defaults to ./uploads if unset.
UPLOADS_DIR=

# Public base URL this server is reachable at, used to build absolute image URLs
# returned by POST /uploads (e.g. https://api.designspartans.com)
API_PUBLIC_BASE_URL=https://api-admin.designspartans.com

# Comma-separated list of origins allowed to make credentialed/browser requests
# (the admin panel's dev + production URLs)
CORS_ORIGIN=http://localhost:5173
